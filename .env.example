# Copy to .env (NEVER commit .env) or export these in your shell.
# The application reads environment variables only; it does not load .env automatically.

# Secret. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Model ids change; check https://ai.google.dev/gemini-api/docs/deprecations
# (gemini-2.0-flash was shut down on 2026-06-01).
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. keyword = offline rules only | gemini = model with keyword fallback | auto = model if a key is set
SERVICEFLOW_CLASSIFIER=auto

# Optional. Seconds before a model call is abandoned and the keyword fallback is used.
GEMINI_TIMEOUT_S=10
